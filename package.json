{
  "name": "spoken-mcp",
  "version": "0.4.2",
  "mcpName": "io.github.spokenmd/spoken",
  "description": "MCP server for Spoken — fetch podcast transcripts as clean Markdown with real speaker names. Built for AI agents.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "bin": {
    "spoken-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "podcast",
    "transcript",
    "transcription",
    "ai-agents",
    "spoken"
  ],
  "homepage": "https://spoken.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spokenmd/spoken.git"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
